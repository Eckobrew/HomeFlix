# ==============================================================================
# HomeStream Configuration
# ==============================================================================

# Application Name (default: HomeStream)
APP_NAME=HomeStream
NEXT_PUBLIC_APP_NAME=HomeStream

# Application Port (default: 3000)
PORT=3000

# ------------------------------------------------------------------------------
# Jellyfin Media Server Settings
# ------------------------------------------------------------------------------
# The LAN or public URL to your Jellyfin server (no trailing slash)
# Example: http://192.168.1.50:8096 or https://jellyfin.yourdomain.com
JELLYFIN_URL=http://192.168.1.50:8096

# Jellyfin API Key
# Generated in Jellyfin Dashboard -> Advanced -> API Keys -> "+" (Create Key named "HomeStream")
JELLYFIN_API_KEY=your_jellyfin_api_key_here

# (Optional) Specific Jellyfin User ID.
# Leave blank to automatically use the primary/first user on the server.
JELLYFIN_USER_ID=

# ------------------------------------------------------------------------------
# Seerr (Jellyseerr / Overseerr) Settings
# ------------------------------------------------------------------------------
# The LAN or public URL to your Jellyseerr or Overseerr instance (no trailing slash)
# Example: http://192.168.1.50:5055 or https://seerr.yourdomain.com
SEERR_URL=http://192.168.1.50:5055

# Seerr API Key
# Found in Jellyseerr / Overseerr -> Settings -> General -> API Key
SEERR_API_KEY=your_seerr_api_key_here

# ------------------------------------------------------------------------------
# qBittorrent Downloader Settings (Optional - For In-Progress Streaming)
# ------------------------------------------------------------------------------
# The LAN or container URL to your qBittorrent WebUI (no trailing slash)
# Example: http://192.168.1.50:8080 or http://qbittorrent:8080
QBITTORRENT_URL=http://localhost:8080

# qBittorrent WebUI Username & Password
QBITTORRENT_USERNAME=admin
QBITTORRENT_PASSWORD=your_qbittorrent_password_here

# Path to the mounted downloads directory inside container or host
# Default: /downloads
DOWNLOADS_PATH=/downloads

# Native Android / Android TV pairing (disabled unless at least 32 characters).
# Generate: openssl rand -hex 32. Treat as a household password; use HTTPS.
HOMESTREAM_MOBILE_TOKEN=

# Signed web/mobile account sessions; minimum 32 random characters.
# Falls back to HOMESTREAM_MOBILE_TOKEN if empty. Rotation signs out account sessions.
HOMESTREAM_SESSION_SECRET=

# Enable ONLY behind a proxy that strips untrusted forwarding headers and sets
# the real client IP. Otherwise clients must authenticate even on private LANs.
HOMESTREAM_TRUST_PROXY=false

# Optional API bootstrap credential for configuration before Jellyfin login works.
# Send via Authorization: Bearer <token>; minimum 32 characters. Keep private.
HOMESTREAM_SETUP_TOKEN=

# Optional bearer credential accepted ONLY by /api/webhook/arr (minimum 32 chars).
HOMESTREAM_WEBHOOK_TOKEN=
